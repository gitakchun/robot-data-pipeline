# 이 파일을 복사해서 .env 로 만들고 값을 채우기:  cp .env.example .env
# .env 는 비밀번호가 들어 있으니 Git에 올리지 않음 (.gitignore 참고)

POSTGRES_USER=robot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=robot_data

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-8chars

# 파이프라인 코드가 접속할 주소 (맥에서 직접 실행할 때 기준)
#  - Airflow 컨테이너 안에서 실행할 땐 minio:9000 / postgres:5432 로 바뀜
MINIO_ENDPOINT=http://localhost:9000
PG_HOST=localhost
PG_PORT=5433
